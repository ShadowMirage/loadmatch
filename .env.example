# Docker Compose default. If you run the app directly on your host, switch `db` to `localhost`.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/loadmatch
REDIS_URL=redis://redis:6379/0

WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here

ANTHROPIC_API_KEY=your_anthropic_api_key_here

AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET=your_s3_bucket_name_here

ADMIN_API_KEY=your_secure_admin_api_key_here
